# Prompt Enhancer environment template.
# Copy to .env.local (frontend dev) and/or configure in your deployment provider.
# Never commit real credentials.

# --- Browser (static frontend) ---
# Public URL for explicit enhancement and optional predictive fallback (Vercel Function /api/enhance).
# Left blank = AI enhancement and predictive fallback stay disabled; local features continue to work.
NEXT_PUBLIC_ENHANCEMENT_API_URL=https://minto-enhancer.vercel.app/api/enhance

# --- Server (API deployment only - never expose these to the browser) ---

# Kill switch: AI enhancement is served only when this is exactly "true".
AI_ENHANCEMENT_ENABLED=true

# OpenRouter API key placeholder. Replace with a real restricted key to enable AI.
OPENROUTER_API_KEY=

# App attribution sent to OpenRouter (non-secret).
OPENROUTER_SITE_URL=https://minto-enhancer.vercel.app
OPENROUTER_APP_TITLE=Prompt Enhancer

# Exact browser origin allowed to call the API (no trailing path).
ALLOWED_ORIGIN=https://minto-enhancer.vercel.app

# Upstash Redis (REST API credentials) backing global concurrency admission.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_CONCURRENCY_LIMIT=8

# Local development only: with no Upstash credentials configured, this admits
# enhancement requests without the global concurrency lease. Never set this in
# a shared or production deployment.
# AI_ADMISSION_OPEN=true

# Upstream timeout for OpenRouter calls in milliseconds.
OPENROUTER_TIMEOUT_MS=65000
